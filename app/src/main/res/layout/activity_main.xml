<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp" android:background="@color/cream">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="PAPAlarm ✨" android:textSize="30sp" android:textStyle="bold" android:textColor="@color/forest_text"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="Rutinitasku" android:textSize="16sp" android:textColor="#6A6A72"/>

    <TextView android:id="@+id/tvSummary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:background="@drawable/bg_card" android:text="Belum ada rutinitas hari ini 🌙"
        android:textSize="15sp" android:textColor="@color/forest_text"/>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp"/>

    <Button android:id="@+id/btnAdd" android:layout_width="match_parent" android:layout_height="58dp"
        android:background="@drawable/bg_button" android:text="＋ Tambah Alarm" android:textAllCaps="false"
        android:textSize="17sp" android:textStyle="bold" android:textColor="@color/forest_text"/>
</LinearLayout>
